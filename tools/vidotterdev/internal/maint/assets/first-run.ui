<ui version="4.0">
 <class>VidOtterFirstRun</class>
 <widget class="QWidget" name="VidOtterFirstRun">
  <layout class="QVBoxLayout" name="verticalLayout">
   <item><widget class="QLabel" name="setupTitle">
    <property name="text"><string>Finish setting up VidOtter</string></property>
    <property name="styleSheet"><string>font-weight: 600; font-size: 15px;</string></property>
   </widget></item>
   <item><widget class="QLabel" name="setupDescription">
