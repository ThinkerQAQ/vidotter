   </widget></item>
   <item><widget class="QCheckBox" name="openExtensionCheckBox">
    <property name="text"><string>Open browser extensions and the VidOtter extension folder</string></property>
    <property name="checked"><bool>true</bool></property>
   </widget></item>
   <item><widget class="QLabel" name="extensionInstructions">
    <property name="text"><string>In the browser: turn on Developer mode, choose Load unpacked, then select the opened extension folder.</string></property>
